<div class="flex items-center gap-3 mb-8">
  <%= link_to admin_cup_matches_path, class: "text-xs text-slate-400 hover:text-slate-700 transition-colors" do %>
    ← Partidas da Copa
  <% end %>
  <div>
    <h1 class="text-xl font-bold text-slate-900">Editar Partida</h1>
    <p class="text-sm text-slate-400 mt-0.5"><%= @cup_match.title %></p>
  </div>
</div>

<div class="bg-white border border-slate-200 rounded-xl shadow-sm p-6 mb-6">
  <%= form_with model: @cup_match, url: admin_cup_match_path(@cup_match), method: :patch do |f| %>
    <%= render "form", f: f, cup_match: @cup_match %>
    <div class="mt-6 flex gap-3">
      <%= f.submit "Salvar Alterações",
          class: "bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-5 py-2 rounded-lg transition-colors cursor-pointer" %>
      <%= link_to "Cancelar", admin_cup_matches_path,
          class: "text-sm text-slate-500 hover:text-slate-700 px-5 py-2 transition-colors" %>
    </div>
  <% end %>
</div>

<%# Definir resultado %>
<% unless @cup_match.finished? %>
  <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-6">
    <h2 class="text-sm font-bold text-slate-700 mb-4">Definir Resultado Final</h2>
    <%= form_with url: set_result_admin_cup_match_path(@cup_match), method: :patch, class: "flex items-end gap-3 flex-wrap" do |f| %>
      <div>
        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Gols Mandante</label>
        <input type="number" name="cup_match[home_score]" min="0" max="20" value="0"
               class="w-20 border border-slate-200 rounded-lg px-3 py-2 text-sm font-bold text-center focus:outline-none focus:ring-2 focus:ring-emerald-300">
      </div>
      <span class="text-slate-400 font-black pb-2">×</span>
      <div>
        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Gols Visitante</label>
        <input type="number" name="cup_match[away_score]" min="0" max="20" value="0"
               class="w-20 border border-slate-200 rounded-lg px-3 py-2 text-sm font-bold text-center focus:outline-none focus:ring-2 focus:ring-emerald-300">
      </div>
      <button type="submit"
              data-turbo-confirm="Confirmar resultado e calcular pontos de todos os palpites?"
              class="bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold px-5 py-2 rounded-lg transition-colors cursor-pointer">
        Confirmar Resultado
      </button>
    <% end %>
    <p class="text-xs text-slate-400 mt-3">⚠️ Ao confirmar, os pontos de todos os bolões serão calculados automaticamente.</p>
  </div>
<% else %>
  <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-4 text-center">
    <p class="text-sm font-bold text-emerald-700">✓ Resultado já definido: <%= @cup_match.result_label %></p>
    <p class="text-xs text-emerald-600 mt-1">Os palpites já foram calculados.</p>
  </div>
<% end %>
